# Same Postgres database that http-server and ws-server use.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/Qtrive

PORT=5000

# The one super-admin login. Use a long random password in production.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-something-long

# Signs admin tokens. Must be at least 32 characters and different from
# http-server's JWT_SECRET, so a user token can never pass as an admin one.
# Generate one with: openssl rand -hex 32
ADMIN_JWT_SECRET=

# Where the admin panel is hosted, comma-separated (e.g. your Vercel URL).
# Required: only these origins may call the API from a browser.
ADMIN_ORIGIN=http://localhost:5174

# A session that has not finished this many hours after it started counts
# as abandoned and can be cancelled from the panel.
STALE_SESSION_HOURS=3
