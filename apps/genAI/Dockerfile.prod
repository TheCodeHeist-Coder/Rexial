FROM python:3.11-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HF_HOME=/models \
    FASTEMBED_CACHE_PATH=/models \
    PIP_DEFAULT_TIMEOUT=120 \
    PIP_RETRIES=10

WORKDIR /app/apps/genAI


# dependencies stage
FROM base AS deps

COPY apps/genAI/requirements.txt ./requirements.txt

RUN --mount=type=cache,target=/root/.cache/pip \
    python -m venv /venv \
    && /venv/bin/pip install --upgrade pip \
    && /venv/bin/pip install --resume-retries 10 -r requirements.txt

# bake the embedding model into the image so the container does not
# download it on a cold start (keep in sync with EMBEDDING_MODEL in
# app/rag/rag_system.py)
COPY apps/genAI/app/rag/rag_system.py /tmp/rag_system.py
RUN MODEL=$(grep -oP 'EMBEDDING_MODEL = "\K[^"]+' /tmp/rag_system.py) \
    && echo "Baking embedding model: $MODEL" \
    && /venv/bin/python -c "\
import sys; from fastembed import TextEmbedding; \
TextEmbedding(sys.argv[1])" "$MODEL" \
    && rm /tmp/rag_system.py \
    && /venv/bin/pip uninstall -y pip setuptools


# prod stage
FROM base AS runner

ENV PATH="/venv/bin:$PATH" \
    UPLOAD_DIR=/data/uploads \
    HF_HUB_OFFLINE=1

# run as an unprivileged user. Ownership is set with COPY --chown rather
# than chown -R, which would duplicate the whole model into a new layer.
RUN useradd --create-home --uid 1001 genai \
    && mkdir -p /data/uploads \
    && chown genai:genai /data/uploads

COPY --from=deps /venv /venv
COPY --from=deps --chown=genai:genai /models /models

COPY apps/genAI/app ./app

USER genai

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
